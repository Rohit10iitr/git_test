# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# ─── Customer config ──────────────────────────────────────────────────────────
# Option A (local dev): leave this blank and the server reads customers.json.
#
# Option B (production): paste the full JSON of your customers.json here.
# This avoids having to commit or mount a secrets file.
# Example:
# CUSTOMER_CONFIG={"customers":{"acme-corp":{"name":"Acme Corp","apiKey":"crust_live_...","enabled":true}}}
CUSTOMER_CONFIG=

# Path to customers.json (only used when CUSTOMER_CONFIG is not set).
# Defaults to ./customers.json relative to the project root.
CUSTOMERS_CONFIG_PATH=
